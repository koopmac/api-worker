{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "termina-rates-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // Bundle the SQL files into the Worker as text
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // Served on api.termina.com. The edge cache only works on a custom domain, not *.workers.dev.
  "routes": [{ "pattern": "api.termina.com", "custom_domain": true }],

  // 120 requests per minute per IP. namespace_id is any integer unique to your account.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],

  "vars": {
    "SITE_URL": "https://termina.com",
    "PAGE_PATH_TEMPLATE": "/cheapest-business-electricity/{state}",
    "METABASE_URL": "https://metabase.termina.io",
    // The rates database's ID in Metabase (the "database" value in your /api/dataset queries)
    "METABASE_DATABASE_ID": "1"
  },
  // Secrets: set in the Cloudflare dashboard (Worker > Settings > Variables and Secrets)
  // or with `npx wrangler secret put <NAME>`:
  //   CF_ACCESS_CLIENT_ID, CF_ACCESS_CLIENT_SECRET, METABASE_API_KEY

  "observability": { "enabled": true }
}
